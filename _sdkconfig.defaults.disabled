# 日志同时走硬件 UART0 和 USB-Serial-JTAG。
# UART0 默认引脚 = GPIO43(U0TXD) / GPIO44(U0RXD)，
# 在 ESP32-S3-MINI-1 上是模块第 39/40 脚，原理图网络名 TXD0 / RXD0，只接 TP1 / TP10。
# 这样深睡唤醒时 USB-JTAG 会重新枚举，但接在 TXD0 上的串口工具不会掉线。
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
